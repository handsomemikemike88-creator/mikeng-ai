# mikeng_course backend — copy to .env (never commit real values). LOCAL ONLY.
PORT=3100
NODE_ENV=development            # production => Secure cookies, APP_SECRET required, no dev invite code
APP_SECRET=                     # long random string; signs media URLs (dev: auto-generated into data/app.db)
APP_DB=data/app.db
UPLOAD_DIR=uploads              # outside the public root; videos streamed only via signed URLs
MAX_UPLOAD_MB=500
MEDIA_URL_TTL_MIN=120
BCRYPT_ROUNDS=12
STAFF_INVITE_CODE=              # shared invite code; accounts made with it wait for admin approval (dev: generated + printed)
ADMIN_EMAIL=                    # optional: first admin created at start-up if missing
ADMIN_PASSWORD=                 # min 10 chars; or use: npm run admin:create
ADMIN_NAME=
DEMO_CUSTOMER_PASSWORD=         # optional, dev only: creates the demo customer login (demo01@example.com). No default.
BACKEND=                        # set to off to disable the backend hook in server.js
SUBMISSIONS_FILE=data/submissions.json
OUTBOX_FILE=data/outbox.jsonl   # reminder drafts are logged here as stubs; nothing is ever sent
SITE_INDEXABLE=0
# Stripe: TEST MODE ONLY. Used by the admin 「完成課程實體堂購買」 sample-order checkout (lib/backend/stripe-test.js).
# The server REFUSES TO START with sk_live_/rk_live_ keys. Missing key -> admin warning, checkout button disabled.
STRIPE_SECRET_KEY=              # sk_test_...
STRIPE_WEBHOOK_SECRET=          # whsec_...  (local: `stripe listen --forward-to localhost:3100/api/stripe/webhook` prints it)
PUBLIC_BASE_URL=                # optional, e.g. http://localhost:3100 (Checkout success/cancel URLs; default = request host)
STRIPE_API_BASE=                # dev/test only: local mock (node scripts/stripe-mock.js -> http://127.0.0.1:12111). Ignored in production.
# The public site checkout (/api/checkout in server.js) is still a stub.
# Per-product TEST Price IDs: EITHER one JSON map keyed by product id ...
STRIPE_PRICE_MAP=               # {"online-video":"price_...","online-1on1":"price_...","ip-gemini":"price_..."}
# ... OR one variable per product (in-person: STRIPE_PRICE_INPERSON_<SLUG>, slug upper-cased, '-' -> '_'):
STRIPE_PRICE_ONLINE_VIDEO=
STRIPE_PRICE_ONLINE_1ON1=
STRIPE_PRICE_INPERSON_GEMINI=
STRIPE_PRICE_INPERSON_GEMINI_NOTEBOOKLM_TRAVEL=
STRIPE_PRICE_INPERSON_STITCH=
STRIPE_PRICE_INPERSON_FLOW=
STRIPE_PRICE_INPERSON_SPARK=
STRIPE_PRICE_INPERSON_CLAUDE_CODEX_INVESTING=
STRIPE_PRICE_INPERSON_HERMES_AGENT=
# admin-added online courses: STRIPE_PRICE_COURSE_<SLUG>
